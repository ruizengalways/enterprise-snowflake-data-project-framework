{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-snowflake.example/schemas/silver_pipeline.schema.json",
  "title": "Enterprise Snowflake Silver Pipeline Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline"],
  "properties": {
    "schema_version": {"const": 1},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern", "raw_contract", "input", "output"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "pattern": {"enum": ["append", "full_refresh", "scd1", "scd2", "custom"]},
        "raw_contract": {"type": "string", "pattern": "^contracts/raw/[a-z][a-z0-9_]*/[A-Za-z0-9_.-]+\\.ya?ml$"},
        "input": {"type": "object", "additionalProperties": false, "required": ["relation"], "properties": {"relation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"}}},
        "output": {"type": "object", "additionalProperties": false, "properties": {"relation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"}, "current": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"}, "history": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"}}},
        "tracked_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
      },
      "allOf": [
        {"if": {"properties": {"pattern": {"const": "append"}}, "required": ["pattern"]}, "then": {"properties": {"output": {"required": ["relation"]}}}},
        {"if": {"properties": {"pattern": {"const": "full_refresh"}}, "required": ["pattern"]}, "then": {"properties": {"output": {"required": ["relation"]}}}},
        {"if": {"properties": {"pattern": {"const": "custom"}}, "required": ["pattern"]}, "then": {"properties": {"output": {"required": ["relation"]}}}},
        {"if": {"properties": {"pattern": {"const": "scd1"}}, "required": ["pattern"]}, "then": {"properties": {"output": {"required": ["current"]}}}},
        {"if": {"properties": {"pattern": {"const": "scd2"}}, "required": ["pattern"]}, "then": {"required": ["tracked_columns"], "properties": {"output": {"required": ["history", "current"]}}}}
      ]
    }
  }
}
