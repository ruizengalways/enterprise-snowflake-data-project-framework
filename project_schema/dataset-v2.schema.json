{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-snowflake.example/schemas/dataset-v2.schema.json",
  "title": "Enterprise Snowflake Dataset Metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset"],
  "properties": {
    "schema_version": {"const": 2},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team", "raw_contract", "load"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "owner_team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "raw_contract": {
          "type": "string",
          "pattern": "^contracts/raw/[A-Za-z0-9_.-]+\\.ya?ml$"
        },
        "load": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "execution"],
          "properties": {
            "strategy": {
              "enum": [
                "full_refresh",
                "append_only",
                "incremental_merge",
                "scd1",
                "scd2",
                "custom"
              ]
            },
            "execution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": {
                  "enum": [
                    "dbt_batch",
                    "dbt_snapshot",
                    "dynamic_table",
                    "stream_task",
                    "custom"
                  ]
                },
                "target_lag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"mode": {"const": "dynamic_table"}},
                    "required": ["mode"]
                  },
                  "then": {"required": ["target_lag"]}
                },
                {
                  "if": {
                    "properties": {"mode": {"const": "stream_task"}},
                    "required": ["mode"]
                  },
                  "then": {"required": ["schedule"]}
                }
              ]
            },
            "business_key": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "watermark_column": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "scd2": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tracked_columns"],
              "properties": {
                "effective_at_column": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "order_columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "tracked_columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "operation_column": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "delete_values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "late_arriving_policy": {
                  "enum": ["rebuild_affected_keys"]
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "strategy": {
                    "enum": ["incremental_merge", "scd1", "scd2"]
                  }
                },
                "required": ["strategy"]
              },
              "then": {"required": ["business_key"]}
            },
            {
              "if": {
                "properties": {"strategy": {"const": "scd2"}},
                "required": ["strategy"]
              },
              "then": {"required": ["scd2"]}
            }
          ]
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warn_after_minutes", "error_after_minutes"],
          "properties": {
            "warn_after_minutes": {"type": "integer", "minimum": 1},
            "error_after_minutes": {"type": "integer", "minimum": 1}
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "measures": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "row_count",
                  "distinct_business_key",
                  "min_max_source_timestamp"
                ]
              }
            }
          }
        }
      }
    }
  }
}
