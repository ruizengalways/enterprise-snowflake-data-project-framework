{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-snowflake.example/schemas/dataset.schema.json",
  "title": "Enterprise Snowflake Dataset Metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset"],
  "properties": {
    "schema_version": {"const": 2},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "materialization", "runtime"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "owner_team": {"type": "string", "minLength": 1, "maxLength": 128},
        "raw_contract": {"type": "string", "pattern": "^contracts/raw/[A-Za-z0-9_.-]+\\.ya?ml$"},
        "load": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {"enum": ["full_refresh", "append_only", "incremental_merge", "scd1", "scd2", "custom"]},
            "business_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
            "watermark_column": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "scd2": {
              "type": "object",
              "additionalProperties": false,
              "required": ["effective_at_column", "order_columns", "tracked_columns", "late_arrival"],
              "properties": {
                "effective_at_column": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                "order_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
                "tracked_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
                "delete": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["operation_column", "values"],
                  "properties": {
                    "operation_column": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                    "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
                  }
                },
                "late_arrival": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["strategy"],
                  "properties": {"strategy": {"const": "rebuild_affected_keys"}}
                }
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"strategy": {"enum": ["incremental_merge", "scd1", "scd2"]}}, "required": ["strategy"]},
              "then": {"required": ["business_key"]}
            },
            {
              "if": {"properties": {"strategy": {"const": "scd2"}}, "required": ["strategy"]},
              "then": {"required": ["scd2"]}
            }
          ]
        },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["table", "view", "dynamic_table", "snapshot", "custom"]},
            "target_lag": {"type": "string", "minLength": 1, "maxLength": 64},
            "refresh_mode": {"enum": ["adaptive", "incremental", "full"]}
          },
          "allOf": [
            {
              "if": {"properties": {"type": {"const": "dynamic_table"}}, "required": ["type"]},
              "then": {"required": ["target_lag"]}
            }
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["dbt", "snowflake_managed", "task", "stream_task", "external", "custom"]},
            "schedule": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"workload": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}}
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "freshness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["warn_after_minutes", "error_after_minutes"],
              "properties": {
                "warn_after_minutes": {"type": "integer", "minimum": 1},
                "error_after_minutes": {"type": "integer", "minimum": 1}
              }
            },
            "reconciliation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {"type": "boolean"},
                "measures": {"type": "array", "uniqueItems": true, "items": {"enum": ["row_count", "distinct_business_key", "min_max_source_timestamp"]}}
              }
            }
          }
        }
      }
    }
  }
}
